{
  "name": "portfolio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "d1:migrate:local": "wrangler d1 execute portfolio-db --local --file=./d1/schema.sql --yes",
    "d1:migrate:remote": "wrangler d1 execute portfolio-db --remote --file=./d1/schema.sql --yes",
    "pages:deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "wrangler": "^4.151.3"
  }
}
