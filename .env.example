# ==============================================================================
# ENVIRONMENT TEMPLATE — Portfolio Monorepo (.env.example)
# Copy this file to '.env' (for local Vite/Node development) and '.dev.vars'
# (for local Cloudflare Pages / Wrangler functions).
#
# IMPORTANT: Never commit '.env' or '.dev.vars' with real credentials to Git!
# In Cloudflare Pages production, add these under Settings > Environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Administrator Authentication Secrets (Pages Functions runtime only)
# ------------------------------------------------------------------------------
# Independent admin master secrets for each portfolio website:
MC_ADMIN_SECRET=
PRO_ADMIN_SECRET=

# Optional: Pre-hashed SHA-256 hex password values (preferred for high-security environments):
# Generate via: echo -n "your_password_here" | sha256sum
MC_ADMIN_PASSWORD_HASH=
PRO_ADMIN_PASSWORD_HASH=

# Backwards-compatible legacy fallback:
ADMIN_SECRET=

# ------------------------------------------------------------------------------
# 2. Email Forwarding Service (Optional — Resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_EMAIL=shreeharsha2027@gmail.com

# ------------------------------------------------------------------------------
# 3. Environment & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development
